import { Theme } from "theme.slint";
import { Choice, DeviceItem } from "backend.slint";
import { BatteryBadge, Caption, Hairline, LinkStatus, MenuRow, Steps, TextButton } from "widgets.slint";

/// A caption over one control, packed for the panel.
component Row {
    in property <string> title;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        spacing: 6px;
        Caption {
            text: root.title;
        }

        @children
    }
}

/// Options packed for the panel's width.
component PanelSteps inherits Steps {
    option-width: 36px;
    option-pad: 14px;
}

/// The window that opens from the tray icon: the selected mouse's DPI
/// stage, polling rate and profile, without the whole app. Rust sizes and
/// places it by the pointer and closes it when it loses focus.
export component TrayPanel inherits Window {
    title: "Open Synapse";
    no-frame: true;
    always-on-top: true;
    background: Theme.surface;
    default-font-family: Theme.body;
    default-font-size: 13.5px;
    width: root.panel-width;
    height: root.panel-height;
    out property <length> panel-width: 320px;
    out property <length> panel-height: content.preferred-height;

    in property <[DeviceItem]> devices;
    in property <int> device: -1;
    in property <string> name;
    in property <string> link;
    in property <bool> asleep;
    in property <bool> has-battery;
    in property <int> battery;
    in property <bool> charging;
    /// Each stage's DPI, valued by its index; empty for mice without stages.
    in property <[Choice]> stages;
    in property <int> active-stage;
    /// The one DPI of a mouse without stages, or empty.
    in property <string> dpi;
    in property <[Choice]> poll-rates;
    in property <int> poll;
    in property <[string]> profiles;
    in property <int> profile;
    in property <bool> scanned;
    /// Whether the panel is on its way in or out: the content slides and
    /// fades with it, while Rust fades the window itself.
    in property <bool> shown;
    property <bool> ready: root.device >= 0 && !root.asleep;

    callback select-device(int);
    callback activate-stage(int);
    callback set-poll(int);
    callback select-profile(int);
    callback open();
    callback quit();
    callback dismiss();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    body := Rectangle {
        opacity: root.shown ? 1 : 0;
        y: root.shown ? 0 : 6px;
        animate opacity, y {
            duration: 160ms;
            easing: ease-out;
        }
        content := VerticalLayout {
            padding: 1px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.device >= 0 ? root.name.to-uppercase() : root.scanned ? "NO MOUSE" : "";
                        font-family: Theme.display;
                        font-size: 14px;
                        letter-spacing: 1.4px;
                        color: Theme.text;
                        overflow: elide;
                    }

                    if root.device >= 0: LinkStatus {
                        asleep: root.asleep;
                        link: root.link;
                    }
                }

                if root.ready && root.has-battery: BatteryBadge {
                    horizontal-stretch: 0;
                    level: root.battery;
                    charging: root.charging;
                }
            }

            Hairline { }

            if root.devices.length > 1: VerticalLayout {
                VerticalLayout {
                    padding: 4px;
                    for item[i] in root.devices: MenuRow {
                        text: item.name;
                        detail: item.battery >= 0 ? item.battery + "%" : item.link;
                        current: i == root.device;
                        clicked => { root.select-device(i); }
                    }
                }

                Hairline { }
            }

            if root.device < 0 && root.scanned: HorizontalLayout {
                padding: 16px;
                Text {
                    text: "Plug in a Razer mouse or its receiver.";
                    font-size: 12.5px;
                    color: Theme.text-3;
                }
            }
            if root.device >= 0 && root.asleep: HorizontalLayout {
                padding: 16px;
                Text {
                    text: "Move the mouse to wake it.";
                    font-size: 12.5px;
                    color: Theme.text-2;
                }
            }

            if root.ready && root.stages.length > 0: Row {
                title: "DPI STAGE";
                PanelSteps {
                    options: root.stages;
                    value: root.active-stage;
                    selected(i) => { root.activate-stage(i); }
                }
            }
            if root.ready && root.stages.length == 0 && root.dpi != "": Row {
                title: "DPI";
                Text {
                    height: 28px;
                    text: root.dpi;
                    font-family: Theme.display;
                    font-size: 15px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            if root.ready && root.poll-rates.length > 0: Row {
                title: "POLLING RATE, HZ";
                PanelSteps {
                    options: root.poll-rates;
                    value: root.poll;
                    selected(rate) => { root.set-poll(rate); }
                }
            }

            if root.profiles.length > 1: VerticalLayout {
                padding-top: 12px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Caption {
                        text: "PROFILE";
                    }
                }

                VerticalLayout {
                    padding-top: 6px;
                    padding-left: 4px;
                    padding-right: 4px;
                    for name[i] in root.profiles: MenuRow {
                        text: name;
                        current: i == root.profile;
                        clicked => { root.select-profile(i); }
                    }
                }
            }

            VerticalLayout {
                padding-top: 10px;
                Hairline { }
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                TextButton {
                    text: "OPEN SYNAPSE";
                    clicked => { root.open(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                TextButton {
                    text: "QUIT";
                    danger: true;
                    clicked => { root.quit(); }
                }
            }
        }

        // The frame, over the content so nothing covers it.
        Rectangle {
            border-width: 1px;
            border-color: Theme.line-strong;
        }
    }
}
