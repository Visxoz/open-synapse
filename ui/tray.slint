export component Tray inherits SystemTrayIcon {
    icon: @image-url("assets/tray.png");
    in property <string> status: "Open Synapse";
    tooltip: root.status;
    in property <[string]> profiles;
    in property <int> profile;
    /// A click on the icon, which opens the panel.
    callback panel();
    callback open();
    callback choose(int);
    callback quit();
    clicked => { root.panel(); }

    Menu {
        MenuItem {
            title: "Show Open Synapse";
            activated => { root.open(); }
        }

        MenuSeparator { }

        for name[i] in root.profiles: MenuItem {
            title: name;
            checkable: true;
            checked: i == root.profile;
            activated => { root.choose(i); }
        }

        MenuSeparator { }

        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
