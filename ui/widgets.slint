import { Theme, Icons } from "theme.slint";
import { Choice } from "backend.slint";

export component Icon {
    in property <string> path;
    in property <color> color: Theme.text-2;
    in property <length> size: 16px;
    width: root.size;
    min-height: root.size;
    preferred-height: root.size;
    Path {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        commands: root.path;
        fill: root.color;
        viewbox-width: 24;
        viewbox-height: 24;
    }
}

/// Small capitals that name a group of controls.
export component Caption inherits Text {
    font-family: Theme.display;
    font-size: 11px;
    letter-spacing: 1.6px;
    color: Theme.text-3;
}

export component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

/// A read-only value beside a field's label; `code` for identifiers.
export component Value inherits Text {
    in property <bool> code;
    font-family: root.code ? Theme.mono : Theme.display;
    font-size: root.code ? 12px : 14px;
    color: Theme.text;
    vertical-alignment: center;
    wrap: word-wrap;
    horizontal-stretch: 1;
}

export component TextButton {
    in property <string> text;
    in property <string> icon;
    in property <bool> accent;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    property <color> colour: !root.enabled ? Theme.text-3 : root.danger && touch.has-hover ? Theme.danger : root.accent ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-2;
    height: 28px;
    min-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 5px;
        if root.icon != "": Icon {
            path: root.icon;
            size: 14px;
            color: root.colour;
        }
        Text {
            text: root.text;
            font-family: Theme.display;
            font-size: 12px;
            letter-spacing: 1.2px;
            color: root.colour;
            animate color { duration: Theme.fast; }
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// A titled group: a caption over a rule, then its rows.
export component Section {
    in property <string> title;
    in property <string> action;
    callback act();
    VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            height: 34px;
            Caption {
                text: root.title;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.action != "": TextButton {
                text: root.action;
                clicked => { root.act(); }
            }
        }

        Hairline { }
        @children
    }
}

/// A row: its name on the left, its control on the right.
export component Field {
    in property <string> label;
    /// A plain explanation under the label, for settings that need one.
    in property <string> detail;
    in property <bool> divider: true;
    min-height: 52px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            width: Theme.label-width;
            alignment: center;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 3px;
            Text {
                text: root.label;
                font-size: 13.5px;
                color: Theme.text-2;
                wrap: word-wrap;
            }

            if root.detail != "": Text {
                text: root.detail;
                font-size: 11.5px;
                color: Theme.text-3;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            @children
        }
    }

    if root.divider: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

/// Exclusive options in a row, the chosen one underlined.
export component Steps {
    in property <[Choice]> options;
    in property <int> value;
    callback selected(int);
    height: 34px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        alignment: start;
        for option in root.options: Rectangle {
            min-width: max(44px, label.preferred-width + 22px);
            label := Text {
                text: option.label;
                font-family: Theme.display;
                font-size: 13px;
                color: option.value == root.value || touch.has-hover ? Theme.text : Theme.text-2;
                animate color { duration: Theme.fast; }
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Grows from the middle when chosen.
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                width: option.value == root.value ? parent.width : 0;
                x: (parent.width - self.width) / 2;
                background: Theme.accent;
                animate width {
                    duration: 160ms;
                    easing: ease-out;
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(option.value); }
            }
        }
    }
}

export component Toggle {
    in property <bool> checked;
    callback toggled(bool);
    width: 34px;
    height: 18px;
    Rectangle {
        border-radius: Theme.radius;
        background: root.checked ? Theme.accent : transparent;
        border-width: root.checked ? 0 : 1px;
        border-color: touch.has-hover ? Theme.text-2 : Theme.line-strong;
        animate background, border-color { duration: 140ms; }
    }

    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        width: 12px;
        height: 12px;
        border-radius: 1px;
        background: root.checked ? Theme.on-accent : Theme.text-3;
        animate x { duration: Theme.fast; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

/// A fader: `changed` fires while dragging, `released` once let go.
export component Slider {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    callback changed(float);
    callback released(float);
    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : clamp(root.value, root.minimum, root.maximum);
    /// The value shown, following a drag before it is released.
    out property <float> current: root.shown;
    property <float> ratio: (root.shown - root.minimum) / max(root.maximum - root.minimum, 0.0001);
    height: 24px;
    min-width: 160px;

    pure function pick(x: length) -> float {
        return clamp(round((root.minimum + clamp(x / root.width, 0, 1) * (root.maximum - root.minimum)) / root.step) * root.step, root.minimum, root.maximum);
    }

    Rectangle {
        height: 2px;
        background: Theme.line-strong;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: root.width * root.ratio - self.width / 2;
        width: 8px;
        height: 16px;
        border-radius: 1px;
        background: touch.has-hover || root.dragging ? Theme.text : Theme.text-2;
        animate background { duration: Theme.fast; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.dragging = true;
                root.drag-value = root.pick(self.mouse-x);
                root.changed(root.drag-value);
            } else if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.released(root.drag-value);
            }
        }
        moved => {
            if root.dragging && root.pick(self.mouse-x) != root.drag-value {
                root.drag-value = root.pick(self.mouse-x);
                root.changed(root.drag-value);
            }
        }
        scroll-event(ev) => {
            if ev.delta-y != 0 {
                root.released(clamp(root.value + (ev.delta-y > 0 ? root.step : -root.step), root.minimum, root.maximum));
                return accept;
            }
            reject
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> numeric;
    in property <bool> bare;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    public function focus-input() {
        input.focus();
        input.select-all();
    }
    height: 30px;
    border-radius: Theme.radius;
    background: root.bare && !input.has-focus && !touch.has-hover ? transparent : Theme.surface;
    border-width: root.bare && !input.has-focus ? 0 : 1px;
    border-color: input.has-focus ? Theme.text-3 : Theme.line;
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: 100%;
        vertical-alignment: center;
        horizontal-alignment: root.numeric ? right : left;
        single-line: true;
        font-family: root.numeric ? Theme.display : Theme.body;
        font-size: root.numeric ? 14px : 13.5px;
        color: Theme.text;
        selection-background-color: Theme.accent.with-alpha(0.3);
        accepted => {
            root.accepted(self.text);
            self.clear-focus();
        }
    }

    if input.text == "": Text {
        x: 9px;
        width: parent.width - 18px;
        height: 100%;
        vertical-alignment: center;
        horizontal-alignment: root.numeric ? right : left;
        text: root.placeholder;
        font-size: 13px;
        color: Theme.text-3;
    }
}

/// A battery gauge of discrete cells.
export component Gauge {
    in property <int> level;
    in property <int> cells: 10;
    in property <length> cell-width: 6px;
    in property <length> gap: 2px;
    in property <bool> charging;
    property <color> colour: root.charging ? Theme.accent : root.level <= 15 ? Theme.danger : root.level <= 30 ? Theme.warning : Theme.text;
    width: root.cells * (root.cell-width + root.gap) - root.gap;
    for i in root.cells: Rectangle {
        x: i * (root.cell-width + root.gap);
        width: root.cell-width;
        border-radius: 1px;
        background: (i + 0.5) * 100 / root.cells <= root.level ? root.colour : Theme.line-strong;
        animate background { duration: 300ms; }
    }
}

/// A square that says whether a device is reachable.
export component Dot inherits Rectangle {
    in property <bool> on;
    width: 6px;
    height: 6px;
    background: root.on ? Theme.accent : Theme.warning;
}

/// A row in a drop-down menu.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> current;
    callback clicked();
    height: 34px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            width: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 6px;
                    background: root.current ? Theme.accent : transparent;
                }
            }
        }

        Text {
            text: root.text;
            font-size: 13px;
            color: root.current ? Theme.text : Theme.text-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.detail;
            font-family: Theme.display;
            font-size: 12px;
            color: Theme.text-3;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The frame of a drop-down menu.
export component MenuFrame inherits Rectangle {
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line-strong;
    border-radius: Theme.radius;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
}

/// Fades its content in when it appears, as pages do when switched to.
export component Reveal inherits Rectangle {
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity {
        duration: 160ms;
        easing: ease-out;
    }
    VerticalLayout {
        @children
    }
}
