import { Theme } from "theme.slint";
import { ArtLight, ZoneLook } from "backend.slint";

/// LED values, as in the protocol.
export global Leds {
    out property <int> matrix: 0;
    out property <int> scroll: 1;
    out property <int> logo: 4;
    out property <int> backlight: 5;
    out property <int> right: 16;
    out property <int> left: 17;
}

/// Effect values, as Rust numbers them.
export global Kind {
    out property <int> static: 0;
    out property <int> breath: 1;
    out property <int> dual: 2;
    out property <int> random: 3;
    out property <int> spectrum: 4;
    out property <int> wave: 5;
    out property <int> reactive: 6;
    out property <int> blinking: 7;
    out property <int> on: 8;
    out property <int> off: 9;
}

/// What a zone shows `t` seconds into its effect.
export global Preview {
    pure public function colour(look: ZoneLook, t: float) -> color {
        return look.kind == Kind.static || look.kind == Kind.reactive ? look.a
            : look.kind == Kind.breath ? look.a.with-alpha(0.2 + 0.8 * (0.5 - 0.5 * cos(t * 90deg)))
            : look.kind == Kind.dual ? look.a.mix(look.b, 0.5 - 0.5 * cos(t * 90deg))
            : look.kind == Kind.random ? hsv(mod(t * 40, 360), 1, 1).with-alpha(0.2 + 0.8 * (0.5 - 0.5 * cos(t * 90deg)))
            : look.kind == Kind.spectrum || look.kind == Kind.wave ? hsv(mod(t * 60, 360), 1, 1)
            : look.kind == Kind.blinking ? (mod(t, 1) < 0.5 ? look.a : transparent)
            : look.kind == Kind.on ? Theme.accent
            : transparent;
    }
    pure public function animated(kind: int) -> bool {
        return kind == Kind.breath || kind == Kind.dual || kind == Kind.random || kind == Kind.spectrum || kind == Kind.wave || kind == Kind.blinking;
    }
}

/// A shape in the generic mouse's 120 by 200 viewbox, filling it.
component Part inherits Path {
    viewbox-width: 120;
    viewbox-height: 200;
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
}

/// A leader line from a point on the drawing out to a label on either side.
component Callout {
    in property <length> ax;
    in property <length> ay;
    /// Where the label begins, or ends when on the left.
    in property <length> to;
    in property <bool> left;
    in property <string> label;
    in property <bool> strong;
    property <color> colour: root.strong ? Theme.accent : Theme.line-strong;
    x: 0;
    y: 0;
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: 160ms; }
    Rectangle {
        x: root.ax - 2px;
        y: root.ay - 2px;
        width: 4px;
        height: 4px;
        background: root.colour;
        animate background { duration: 140ms; }
    }

    Rectangle {
        x: min(root.ax, root.to);
        y: root.ay;
        width: abs(root.to - root.ax);
        height: 1px;
        background: root.colour;
        animate background { duration: 140ms; }
    }

    Text {
        x: root.left ? root.to - 8px - self.width : root.to + 8px;
        y: root.ay - self.height / 2;
        text: root.label;
        font-family: Theme.display;
        font-size: 11px;
        letter-spacing: 1.4px;
        color: root.strong ? Theme.text : Theme.text-2;
        animate color { duration: 140ms; }
    }
}

/// A mouse drawn in vector lines, standing in for models without a picture.
component Generic {
    in property <color> logo;
    in property <color> wheel;
    in property <color> sides;
    in property <color> under;
    in property <int> selected;
    property <color> ink: Theme.text-3;
    property <string> body: "M60 8 C84 8 100 30 101 70 L103 140 C104 176 86 194 60 194 C34 194 16 176 17 140 L19 70 C20 30 36 8 60 8 Z";

    if root.under.alpha > 0: Part {
        commands: root.body;
        stroke: root.under.with-alpha(0.6);
        stroke-width: 8px;
    }

    Part {
        commands: root.body;
        fill: Theme.background;
        stroke: root.selected == Leds.matrix || root.selected == Leds.backlight ? Theme.accent : Theme.text-2;
        stroke-width: 1.2px;
    }

    // The centre seam, the buttons' edge and the two side buttons.
    Part {
        commands: "M60 8 L60 78 M19.4 80 Q60 90 100.6 80 M15.5 92 L18.6 92 L18.4 106 L15.3 106 Z M15.2 110 L18.3 110 L18.1 124 L15 124 Z";
        stroke: root.ink;
        stroke-width: 1px;
    }

    // The scroll wheel.
    Part {
        commands: "M59 26 L61 26 A4 4 0 0 1 65 30 L65 48 A4 4 0 0 1 61 52 L59 52 A4 4 0 0 1 55 48 L55 30 A4 4 0 0 1 59 26 Z";
        fill: root.wheel;
        stroke: root.selected == Leds.scroll ? Theme.accent : Theme.text-2;
        stroke-width: 1px;
    }

    // The DPI button.
    Part {
        commands: "M57.5 58 L62.5 58 L63.5 59 L63.5 65 L62.5 66 L57.5 66 L56.5 65 L56.5 59 Z";
        stroke: root.ink;
        stroke-width: 1px;
    }

    // The logo.
    Part {
        commands: "M60 143 A7 7 0 0 1 60 157 A7 7 0 0 1 60 143 Z";
        fill: root.logo;
        stroke: root.selected == Leds.logo ? Theme.accent : Theme.text-2;
        stroke-width: 1px;
    }

    // Side strips, shown while lit or selected.
    if root.sides.alpha > 0 || root.selected == Leds.left || root.selected == Leds.right: Part {
        commands: "M101.8 96 L102.6 134 M18.2 96 L17.4 134";
        stroke: root.sides.alpha > 0 ? root.sides : Theme.accent;
        stroke-width: 3px;
    }
}

/// Light from a zone, behind the line art.
component Glow inherits Rectangle {
    in property <color> colour;
    visible: root.colour.alpha > 0;
    width: self.height;
    background: @radial-gradient(circle, root.colour.with-alpha(root.colour.alpha * 0.6) 0%, root.colour.with-alpha(root.colour.alpha * 0.2) 25%, root.colour.with-alpha(0) 48%);
}

/// A part lit as the picture shows it, in the zone's colour, over the line
/// art it hides. Spans the drawing; its images span only the part.
component Light {
    in property <ArtLight> light;
    in property <color> colour;
    visible: root.colour.alpha > 0;
    width: 100%;
    height: 100%;
    Rectangle {
        x: root.light.left * root.width;
        y: root.light.top * root.height;
        width: root.light.width * root.width;
        height: root.light.height * root.height;
        Image {
            width: 100%;
            height: 100%;
            source: root.light.cover;
            colorize: Theme.background.with-alpha(root.colour.alpha);
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.light.image;
            colorize: root.colour;
        }
    }
}

/// The model from above, centred: its picture redrawn as line art when there
/// is one, otherwise a generic mouse. Zones are lit in their colour,
/// transparent when dark, and named by callouts on either side. Where the
/// picture shows a part lit, that part lights; elsewhere a glow stands in.
export component Schematic {
    in property <image> outline-art;
    in property <image> details-art;
    in property <ArtLight> logo-light;
    in property <ArtLight> wheel-light;
    in property <ArtLight> sides-light;
    in property <ArtLight> under-light;
    /// The mouse's body in the drawing, as fractions of its height.
    in property <float> body-top: 0;
    in property <float> body-bottom: 1;
    /// Which zones are the mouse's own: only those get a glow where the
    /// picture shows nothing lit.
    in property <bool> own-logo: true;
    in property <bool> own-wheel: true;
    in property <bool> own-sides: true;
    in property <bool> pending;
    /// The drawing's height; the component spans its parent's width.
    in property <length> size: 400px;
    in property <color> logo: transparent;
    in property <color> wheel: transparent;
    in property <color> sides: transparent;
    in property <color> under: transparent;
    in property <int> selected: -1;
    in property <string> wheel-label;
    in property <string> dpi-label;
    in property <string> side-label;
    in property <string> logo-label;
    in property <string> under-label;
    property <bool> art: root.outline-art.width > 0;
    property <length> w: root.size * (root.art ? root.outline-art.width / root.outline-art.height : 0.6);
    property <length> ox: (root.width - root.w) / 2;
    property <length> oy: (root.height - root.size) / 2;
    property <bool> lit-logo: root.art && root.logo-light.image.width > 0;
    property <bool> lit-wheel: root.art && root.wheel-light.image.width > 0;
    property <bool> lit-sides: root.art && root.sides-light.image.width > 0;
    property <bool> lit-under: root.art && root.under-light.image.width > 0;
    /// Lit sides only on the right, as on a left-handed mouse's thumb side.
    property <bool> sides-right: root.lit-sides && root.sides-light.x > 0.5;

    /// A point on the drawing, as fractions of its width and height.
    function px(f: float) -> length {
        return root.ox + f * root.w;
    }
    function py(f: float) -> length {
        return root.oy + f * root.size;
    }
    /// A height down the body, as a fraction of the drawing.
    function down(f: float) -> float {
        return root.body-top + f * (root.body-bottom - root.body-top);
    }

    if !root.art && !root.pending: Generic {
        x: root.ox;
        y: root.oy;
        width: root.w;
        height: root.size;
        logo: root.logo;
        wheel: root.wheel;
        sides: root.sides;
        under: root.under;
        selected: root.selected;
    }
    if root.art: Rectangle {
        x: root.ox;
        y: root.oy;
        width: root.w;
        height: root.size;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 180ms; }
        Glow {
            x: 0.5 * root.w - self.width / 2;
            y: root.down(0.22) * root.size - self.height / 2;
            height: 0.28 * root.w;
            colour: root.lit-wheel || !root.own-wheel ? transparent : root.wheel;
        }

        Glow {
            x: 0.5 * root.w - self.width / 2;
            y: root.down(0.75) * root.size - self.height / 2;
            height: 0.4 * root.w;
            colour: root.lit-logo || !root.own-logo ? transparent : root.logo;
        }

        for edge in [0, 1]: Glow {
            x: edge * root.w - self.width / 2;
            y: root.down(0.5) * root.size - self.height / 2;
            height: 0.22 * root.w;
            colour: root.lit-sides || !root.own-sides ? transparent : root.sides;
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.outline-art;
            colorize: root.under.alpha > 0 ? root.under : root.selected == Leds.matrix || root.selected == Leds.backlight ? Theme.accent : Theme.text;
            animate colorize { duration: 160ms; }
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.details-art;
            colorize: Theme.text-2;
        }

        if root.lit-under: Light {
            light: root.under-light;
            colour: root.under;
        }
        if root.lit-wheel: Light {
            light: root.wheel-light;
            colour: root.wheel;
        }
        if root.lit-logo: Light {
            light: root.logo-light;
            colour: root.logo;
        }
        if root.lit-sides: Light {
            light: root.sides-light;
            colour: root.sides;
        }
    }

    // The wheel and logo are named on the right; the DPI, sides and
    // underglow on the left, so the drawing stays centred, unless the sides
    // are lit only on the right.
    if root.wheel-label != "": Callout {
        ax: root.px(root.lit-wheel ? root.wheel-light.right + 0.03 : root.art ? 0.56 : 0.542);
        ay: root.py(root.lit-wheel ? root.wheel-light.y : root.down(0.195));
        to: root.ox + root.w + 18px;
        label: root.wheel-label;
        strong: root.selected == Leds.scroll;
    }
    if root.logo-label != "": Callout {
        ax: root.px(root.lit-logo ? root.logo-light.right + 0.03 : root.art ? 0.6 : 0.558);
        ay: root.py(root.lit-logo ? root.logo-light.y : root.down(root.art ? 0.78 : 0.75));
        to: root.ox + root.w + 18px;
        label: root.logo-label;
        strong: root.selected == Leds.logo;
    }
    if root.dpi-label != "": Callout {
        ax: root.px(0.47);
        ay: root.py(0.31);
        to: root.ox - 18px;
        left: true;
        label: root.dpi-label;
    }
    if root.side-label != "": Callout {
        ax: root.px(root.sides-right ? root.sides-light.right + 0.02 : root.art ? 0.03 : 0.15);
        ay: root.py(root.lit-sides ? root.sides-light.y : root.down(root.art ? 0.5 : 0.56));
        to: root.sides-right ? root.ox + root.w + 18px : root.ox - 18px;
        left: !root.sides-right;
        label: root.side-label;
        strong: root.selected == Leds.left || root.selected == Leds.right;
    }
    if root.under-label != "": Callout {
        ax: root.px(root.art ? 0.28 : 0.2);
        ay: root.py(root.down(root.art ? 0.93 : 0.86));
        to: root.ox - 18px;
        left: true;
        label: root.under-label;
        strong: root.selected == Leds.matrix || root.selected == Leds.backlight;
    }
}
